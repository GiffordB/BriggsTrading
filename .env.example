# Alpaca (https://alpaca.markets) - paper trading keys by default
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# Safety switch. Leave as "true" until you have watched the bot run correctly
# on paper trading for a while. Flipping this to "false" requires also setting
# CONFIRM_LIVE_TRADING below, on purpose, so it can't happen by accident.
ALPACA_PAPER=true
CONFIRM_LIVE_TRADING=

# --- Risk (independent of any strategy's own signal -- src/risk_guard.py) ---

# Fraction of account equity risked on a single new entry, sized from the
# stop distance (risk_dollars / stop_pct = position notional), not a flat
# dollar amount.
RISK_PER_TRADE_PCT=0.01

# If today's realized+unrealized P&L falls this far below yesterday's close,
# no new entries until the next UTC day. Existing positions/stops untouched.
DAILY_LOSS_LIMIT_PCT=0.03

# If current equity has fallen this much below its 3-month peak (from
# Alpaca's own portfolio history), halts EVERYTHING -- including managing
# existing positions -- until a human looks.
MAX_DRAWDOWN_PCT=0.15

# Position size is also capped at this multiple of account equity, on top of
# the risk-based sizing above.
MAX_LEVERAGE=2.0

# Whether short-side strategies are allowed to actually enter. Backtesting
# and scoring still happen either way -- this only gates execution.
ALLOW_SHORT=true

# No single position is allowed to exceed this fraction of account equity --
# blocks an entry that would push a position past this concentration.
MAX_POSITION_CONCENTRATION_PCT=0.20

# Total value of all open positions combined can't exceed this fraction of
# account equity -- blocks new entries once total exposure is this high.
MAX_PORTFOLIO_EXPOSURE_PCT=0.75

# Position size is also capped at this fraction of full Kelly (computed from
# each strategy's own backtested win rate / avg win / avg loss) -- guards
# against the backtest's estimate being too optimistic.
KELLY_FRACTION_CAP=0.25

# --- Research pipeline (src/research_pipeline.py, runs nightly) ---

# How many years of daily bars to backtest each strategy over.
BACKTEST_YEARS=5

# Only strategies scoring at or above this (out of 10, see src/rank.py) make
# the morning shortlist.
MIN_SHORTLIST_SCORE=8.0

# Minimum out-of-sample trade count a backtest must produce to even be
# considered -- the "sample size" gate in src/skeptic.py.
MIN_BACKTEST_TRADES=50

# --- Execution (src/execution.py, runs each morning before open) ---

# Manual kill switch. Set to "true" to immediately stop all new orders,
# regardless of any other setting, without touching the research pipeline.
TRADING_HALTED=false

# Max new entries acted on in one morning, even if more survive the
# pipeline -- see playbook.md.
MAX_SETUPS_PER_MORNING=2

# If true, compute and log the entry that would be made but never actually
# submit it.
DRY_RUN=true

# --- Dashboard only (dashboard/app.py, not used by the bot) ---

# How far back to look for news headlines on currently-held tickers.
NEWS_LOOKBACK_DAYS=5

# Required to protect the dashboard, including the manual sell button, from
# anyone who has the URL. Leave blank only for local testing -- the dashboard
# logs a loud warning and runs with NO LOGIN if either is unset.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Powers the "Real Holdings" tracker: your own manually-entered investments
# (e.g. Schwab, 401k) compared against the paper bot's return %. Stored as
# data/real_holdings.json, committed to GITHUB_REPO via the GitHub Contents
# API since the dashboard has no database of its own. Generate a token at
# github.com/settings/tokens -- classic PAT needs the "repo" scope, or a
# fine-grained PAT needs Contents: Read and write on this one repo. Leave
# blank to disable the feature entirely (list/add/edit/delete all no-op).
GITHUB_PAT=
GITHUB_REPO=GiffordB/BriggsTrading
