# Quiver Quantitative API (https://api.quiverquant.com/pricing/ - Hobbyist tier)
QUIVER_API_TOKEN=your_quiver_api_token_here

# Alpaca (https://alpaca.markets) - paper trading keys by default
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# Safety switch. Leave as "true" until you have watched the bot run correctly
# on paper trading for a while. Flipping this to "false" requires also setting
# CONFIRM_LIVE_TRADING below, on purpose, so it can't happen by accident.
ALPACA_PAPER=true
CONFIRM_LIVE_TRADING=

# --- Strategy settings ---

# Fraction of account equity to allocate to each mirrored trade (0.02 = 2%)
POSITION_SIZE_PCT=0.02

# Cap on total notional (dollars) for any single order, regardless of POSITION_SIZE_PCT
MAX_NOTIONAL_PER_TRADE=2000

# Cap on total notional spent on new orders in a single run of the bot
MAX_NOTIONAL_PER_RUN=5000

# Only mirror disclosures at or above this dollar amount (uses the low end of
# the disclosed range, since ranges like "$1,001-$15,000" are all Congress
# reports). Filters out trivial trades.
MIN_TRADE_AMOUNT=15000

# Comma-separated transaction types to mirror. Congress disclosures use
# "Purchase", "Sale (Full)", "Sale (Partial)", "Exchange".
MIRROR_TRANSACTION_TYPES=Purchase

# Optional: comma-separated list of member names to follow exclusively.
# Leave blank to mirror all members.
FOLLOWED_MEMBERS=

# Only look at disclosures filed in the last N days each run
LOOKBACK_DAYS=7

# If true, compute and log intended orders but never actually submit them.
DRY_RUN=true

# --- Risk guard (independent of the strategy filters above) ---

# Manual kill switch. Set to "true" to immediately stop all new orders,
# regardless of any other setting, without touching strategy config.
TRADING_HALTED=false

# If current equity has fallen this much below its 3-month peak (from Alpaca's
# own portfolio history), trading halts automatically until you investigate.
MAX_DRAWDOWN_PCT=0.15

# No single position is allowed to exceed this fraction of account equity --
# blocks a buy that would push a position past this concentration.
MAX_POSITION_CONCENTRATION_PCT=0.20

# Total value of all open positions combined can't exceed this fraction of
# account equity -- blocks new buys once total exposure is this high.
MAX_PORTFOLIO_EXPOSURE_PCT=0.75

# --- Backtesting (src/backtest.py only, not used by the live bot) ---
BACKTEST_DAYS=180
BACKTEST_STARTING_CASH=100000

# --- Confirming signal (optional extra layer, off by default) ---

# If true, only mirror a purchase if that company also shows recent corporate
# lobbying spend or a government contract award (Quiver data already included
# in your Hobbyist plan). Purely a confirming filter -- never adds a trade
# that wouldn't already pass the strategy filters above.
REQUIRE_CONFIRMING_SIGNAL=false

# How far back to look for lobbying/gov-contract activity when the above is on.
CONFIRMING_SIGNAL_LOOKBACK_DAYS=90

# Free alternative/addition to the above: checks SEC EDGAR (no signup, no API
# key) for a recent insider open-market purchase (Form 4, filed within 2
# business days of the trade -- much faster than Congress's 45-day window).
# Used automatically whenever REQUIRE_CONFIRMING_SIGNAL is on. SEC asks
# automated requests identify themselves -- put a real contact here if you
# have one, to stay in good standing with their fair-access policy.
SEC_EDGAR_USER_AGENT=BriggsTrading github.com/GiffordB/BriggsTrading

# --- Insider override (separate from the confirming signal above) ---

# If a corporate insider (officer/director) has filed their own Form 4
# open-market buy or sell for the same ticker a Congress disclosure this run
# is acting on, the insider's action wins -- it files within 2 business days
# vs. Congress's 30-45, so it's the fresher signal. This can override a
# congressional buy into a sell (or vice versa), or even trigger a trade a
# congressional disclosure alone would have been filtered out (e.g. below
# MIN_TRADE_AMOUNT). Always flagged (not silent): the dashboard highlights
# the resulting row and offers a one-click "Reverse" button. Set to false to
# use SEC EDGAR only as the REQUIRE_CONFIRMING_SIGNAL gate above, never as
# its own override.
INSIDER_OVERRIDE_ENABLED=true
INSIDER_OVERRIDE_LOOKBACK_DAYS=10

# --- Dashboard only (dashboard/app.py, not used by the bot) ---

# How far back to look for news headlines on currently-held tickers.
NEWS_LOOKBACK_DAYS=5

# Required to protect the dashboard, including the manual sell button, from
# anyone who has the URL. Leave blank only for local testing -- the dashboard
# logs a loud warning and runs with NO LOGIN if either is unset.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Powers the "Real Holdings" tracker: your own manually-entered investments
# (e.g. Schwab, 401k) compared against the paper bot's return %. Stored as
# data/real_holdings.json, committed to GITHUB_REPO via the GitHub Contents
# API since the dashboard has no database of its own. Generate a token at
# github.com/settings/tokens -- classic PAT needs the "repo" scope, or a
# fine-grained PAT needs Contents: Read and write on this one repo. Leave
# blank to disable the feature entirely (list/add/edit/delete all no-op).
GITHUB_PAT=
GITHUB_REPO=GiffordB/BriggsTrading
