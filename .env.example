# Quiver Quantitative API (https://api.quiverquant.com/pricing/ - Hobbyist tier)
QUIVER_API_TOKEN=your_quiver_api_token_here

# Alpaca (https://alpaca.markets) - paper trading keys by default
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# Safety switch. Leave as "true" until you have watched the bot run correctly
# on paper trading for a while. Flipping this to "false" requires also setting
# CONFIRM_LIVE_TRADING below, on purpose, so it can't happen by accident.
ALPACA_PAPER=true
CONFIRM_LIVE_TRADING=

# --- Strategy settings ---

# Fraction of account equity to allocate to each mirrored trade (0.02 = 2%)
POSITION_SIZE_PCT=0.02

# Cap on total notional (dollars) for any single order, regardless of POSITION_SIZE_PCT
MAX_NOTIONAL_PER_TRADE=2000

# Cap on total notional spent on new orders in a single run of the bot
MAX_NOTIONAL_PER_RUN=5000

# Only mirror disclosures at or above this dollar amount (uses the low end of
# the disclosed range, since ranges like "$1,001-$15,000" are all Congress
# reports). Filters out trivial trades.
MIN_TRADE_AMOUNT=15000

# Comma-separated transaction types to mirror. Congress disclosures use
# "Purchase", "Sale (Full)", "Sale (Partial)", "Exchange".
MIRROR_TRANSACTION_TYPES=Purchase

# Optional: comma-separated list of member names to follow exclusively.
# Leave blank to mirror all members.
FOLLOWED_MEMBERS=

# Only look at disclosures filed in the last N days each run
LOOKBACK_DAYS=7

# If true, compute and log intended orders but never actually submit them.
DRY_RUN=true
